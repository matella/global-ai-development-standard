{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "gads/PROJECT.md"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "python -m unittest*": "allow",
      "python -m pytest*": "allow",
      "python scripts/*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git ls-files*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git checkout -b *": "allow",
      "git switch -c *": "allow",
      "git branch*": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "pwd": "allow",
      "git rev-parse*": "allow",
      "git config --get*": "allow",
      "git config user.*": "allow",
      "git remote -v": "allow",
      "git stash list": "allow",
      "git reset --hard*": "deny",
      "git clean *": "deny",
      "git checkout -- *": "deny",
      "git restore *": "deny",
      "git branch -D *": "deny",
      "git push *": "deny",
      "git filter-branch*": "deny",
      "git filter-repo*": "deny",
      "git rebase *": "deny",
      "gh *": "deny",
      "npm publish*": "deny",
      "docker push*": "deny",
      "rm *": "deny",
      "git -* push*": "deny",
      "git -* reset --hard*": "deny",
      "git -* clean*": "deny",
      "git -* checkout -- *": "deny",
      "git -* restore*": "deny",
      "git -* branch -D*": "deny",
      "git -* filter-branch*": "deny",
      "git -* filter-repo*": "deny",
      "git -* rebase*": "deny",
      "sudo *": "deny",
      "env *": "deny",
      "command *": "deny",
      "* .env": "deny",
      "* .env.*": "deny",
      "*/.env": "deny",
      "*/.env.*": "deny",
      "* *.pem*": "deny",
      "* *.key": "deny",
      "* *.key *": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny"
    },
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "webfetch": "deny"
  }
}
